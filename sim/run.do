# =============================================
# ============ Create Work Library ============
# =============================================
vdel -all
vlib work

# =============================================
# =============== Compile Files ===============
# =============================================
vlog -f files.txt

# =============================================
# =========== Simulate with Coverage ==========
# =============================================

vsim -voptargs=+acc work.axi4_tb

coverage save cov.ucdb -onexit -du work.axi4_memory_fixed

# =============================================
# ============= Add Waves and Run =============
# =============================================

add wave *
run -all

# =============================================
# ============== Coverage Report ==============
# =============================================
coverage report -details -output ./reports/cov_report.txt