# =============================================
# ============ Create Work Library ============
# =============================================
vdel -all
vlib work

# =============================================
# =============== Compile Files ===============
# =============================================
vlog -f ./sim/files.txt

# =============================================
# =========== Simulate with Coverage ==========
# =============================================

vsim -voptargs=+acc work.axi4_tb -cover

coverage save cov.ucdb -onexit -du work.axi4_fixed

# =============================================
# ============= Add Waves and Run =============
# =============================================

add wave *
run -all

# =============================================
# ============== Coverage Report ==============
# =============================================
coverage report -details -du=work.axi4_fixed -output ./reports/cov_report.txt